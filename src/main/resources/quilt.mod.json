{
  "schema_version": 1,
  "quilt_loader": {
    "group": "com.stellar",
    "id": "stellar_tweak",
    "version": "1.0.0",
    "metadata": {
      "name": "Stellar Tweak",
      "description": "Various tweaks and modifications",
      "icon": "assets/stellar_tweak/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "client": {
        "adapter": "kotlin",
        "value": "com.stellar.tweak.StellarTweakMod"
      },
      "modmenu": {
        "adapter": "kotlin",
        "value": "com.stellar.tweak.config.StellarTweakModMenu"
      }
    },
    "depends": [
      {
        "id": "stellar_law",
        "versions": "*",
        "optional": true
      },
      {
        "id": "modmenu",
        "versions": "*",
        "optional": true
      }
    ]
  },
  "mixin": "stellar_tweak.mixins.json"
}
